{
    "manifest_version": 3,
    "name": "Screen Recorder",
    "description": "recorder",
    "version": "1.0.0",
    "action" : {
        "default_popup": "popup.html",
        "default_title": "Screen Recorder",
        "default_icon" : "icon.png"
    },
   
    "permissions": ["tabs", "scripting", "storage", "desktopCapture"],
    "icons": {
        "16" : "icon.png",
        "48" : "icon.png",
        "128" : "icon.png"
    },
    
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["contentScript.js"]
        }
    ]
}